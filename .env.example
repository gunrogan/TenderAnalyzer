POSTGRES_DB=tenderdigest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

OLLAMA_PORT=11434
OLLAMA_URL=http://127.0.0.1:11434

LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_CHARS=60000

STORAGE_DIR=storage
MAX_FILE_SIZE_MB=25

SWAGGER_ENABLED=true
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

WORKER_POOL=threads
WORKER_CONCURRENCY=4

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tenderdigest